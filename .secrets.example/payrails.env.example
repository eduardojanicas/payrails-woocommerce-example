; Payrails credentials for the example store. Copy to .secrets/payrails.env (gitignored):
;   mkdir -p .secrets && cp .secrets.example/payrails.env.example .secrets/payrails.env
;   cp /path/to/client.crt /path/to/client.key .secrets/ && chmod 600 .secrets/*
; Parsed as raw INI: write values as-is (no escaping needed for "$"). Placeholders below.

; Merchant API base URL for your environment (staging or production), provided by Payrails.
; Must be an https://*.payrails.io URL.
PAYRAILS_API_URL=your-payrails-api-url
PAYRAILS_CLIENT_ID=your-client-id
PAYRAILS_CLIENT_SECRET=your-client-secret
; Workspace id (required): without it, client-init answers 401 request.unauthorized.
PAYRAILS_WORKSPACE_ID=your-workspace-id
; A card-enabled acceptance workflow (default: payment-acceptance).
PAYRAILS_WORKFLOW_CODE=payment-acceptance
; mTLS client certificate and key. Relative paths resolve against this file's folder.
PAYRAILS_CERT_PATH=client.crt
PAYRAILS_KEY_PATH=client.key
