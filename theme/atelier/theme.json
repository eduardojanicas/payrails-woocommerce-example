{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Page", "color": "#F7F7F7" },
				{ "slug": "contrast", "name": "Ink", "color": "#1F1F1F" },
				{ "slug": "accent-1", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "accent-2", "name": "Subtle", "color": "#F0F0F0" },
				{ "slug": "accent-3", "name": "Ink hover", "color": "#141414" },
				{ "slug": "accent-4", "name": "Muted text", "color": "#666666" },
				{ "slug": "accent-5", "name": "Soft", "color": "#FAFAFA" },
				{ "slug": "accent-6", "name": "Hairline", "color": "#E6E6E6" },
				{ "slug": "field-border", "name": "Field border", "color": "#949494" },
				{ "slug": "warm", "name": "Warm tint", "color": "#FFF1E5" },
				{ "slug": "warm-ink", "name": "Warm ink", "color": "#92400E" },
				{ "slug": "success", "name": "Success", "color": "#1E7A34" },
				{ "slug": "error", "name": "Error", "color": "#C52020" },
				{ "slug": "error-tint", "name": "Error tint", "color": "#FDF1F1" }
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "80rem"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "elegant", "name": "Elegant", "shadow": "0 2px 8px 0 rgb(0 0 0 / 0.04)" },
				{ "slug": "refined", "name": "Refined", "shadow": "0 4px 12px -2px rgb(0 0 0 / 0.08)" },
				{ "slug": "sophisticated", "name": "Sophisticated", "shadow": "0 8px 24px -4px rgb(0 0 0 / 0.12)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "2XS (8px)", "size": "0.5rem" },
				{ "slug": "30", "name": "XS (16px)", "size": "1rem" },
				{ "slug": "40", "name": "S (24px)", "size": "1.5rem" },
				{ "slug": "50", "name": "M (32px)", "size": "2rem" },
				{ "slug": "60", "name": "L (48px)", "size": "clamp(2rem, 5vw, 3rem)" },
				{ "slug": "70", "name": "XL (64px)", "size": "clamp(2.5rem, 7vw, 4rem)" },
				{ "slug": "80", "name": "2XL (96px)", "size": "clamp(3rem, 10vw, 6rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-variable.woff2"]
						}
					]
				},
				{
					"slug": "crimson-text",
					"name": "Crimson Text",
					"fontFamily": "\"Crimson Text\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Crimson Text",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/crimson-text-latin-400.woff2"]
						},
						{
							"fontFamily": "Crimson Text",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/crimson-text-latin-400-italic.woff2"]
						},
						{
							"fontFamily": "Crimson Text",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/crimson-text-latin-600.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS (12px)", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "S (14px)", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "M (16px)", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "L (18px)", "size": "1.125rem", "fluid": false },
				{ "slug": "x-large", "name": "XL (24px)", "size": "1.5rem", "fluid": { "min": "1.375rem", "max": "1.5rem" } },
				{ "slug": "xx-large", "name": "2XL (30px)", "size": "1.875rem", "fluid": { "min": "1.625rem", "max": "1.875rem" } },
				{ "slug": "display", "name": "Display (36-48px)", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } }
			]
		},
		"custom": {
			"radius": {
				"sm": "4px",
				"md": "6px",
				"lg": "8px",
				"pill": "999px"
			},
			"control": {
				"height": "2.75rem",
				"input-height": "2.75rem"
			},
			"motion": {
				"fast": "200ms",
				"slow": "700ms",
				"easing": "cubic-bezier(0.2, 0, 0, 1)"
			},
			"header": {
				"height": "5rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1.5rem, 4vw, 2rem)",
				"right": "clamp(1.5rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6",
			"letterSpacing": "0"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|crimson-text",
					"fontWeight": "400",
					"lineHeight": "1.25",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|x-small", "fontWeight": "600", "textTransform": "uppercase", "letterSpacing": "0.1em" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|accent-3" },
					"typography": { "textDecoration": "none" }
				},
				":focus": {
					"outline": { "color": "var:preset|color|contrast", "style": "solid", "width": "2px", "offset": "2px" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|accent-5"
				},
				"border": {
					"radius": "var:custom|radius|md",
					"width": "0"
				},
				"spacing": {
					"padding": { "top": "0.8125rem", "bottom": "0.8125rem", "left": "2rem", "right": "2rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"lineHeight": "1.3",
					"letterSpacing": "0.025em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-3",
						"text": "var:preset|color|accent-5"
					}
				},
				":focus": {
					"outline": { "color": "var:preset|color|contrast", "style": "solid", "width": "2px", "offset": "2px" }
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "var:preset|font-size|x-small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|crimson-text",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400",
					"letterSpacing": "0.025em",
					"textTransform": "uppercase",
					"lineHeight": "1.3"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "none" } }
					}
				}
			},
			"core/navigation": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "400" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|contrast" },
							"typography": { "textDecoration": "none" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-terms": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "300" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|accent-4" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var:preset|color|contrast" } }
					}
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|accent-6" }
			},
			"core/button": {
				"border": { "radius": "var:custom|radius|md" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|crimson-text", "fontStyle": "italic" }
			},
			"woocommerce/product-price": {
				"typography": { "fontWeight": "500" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "checkout-header", "title": "Checkout Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
